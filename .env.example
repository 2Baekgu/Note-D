# Supabase — leave these unset to run the site on seeded sample content.
# Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin. Must match Supabase → Authentication → URL Configuration,
# which also needs <origin>/auth/callback in its Redirect URLs list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── seeding only — never set these on Vercel ────────────────────────────
# This key bypasses RLS. `npm run seed` is the only thing that reads it.
SUPABASE_SERVICE_ROLE_KEY=

# The two study members are created as real auth users so the 32 articles have
# an owner. Use the actual Google addresses: signing in with the same address
# links to the seeded account, and authorship carries over.
SEED_SUYEON_EMAIL=
SEED_SIENNA_EMAIL=

# ── daily open-chat pick (/api/daily-pick) ──────────────────────────────
# The shared secret the iPhone Shortcut sends. Any long random string;
# generate one with:  openssl rand -hex 32
DAILY_PICK_TOKEN=

# Absolute base for the article link in the message. Falls back to
# NEXT_PUBLIC_SITE_URL, then to the Vercel deployment URL.
SITE_URL=

# GPT-5-mini writes the three-line summary. Without it the message still
# goes out, using the article's subtitle instead.
# Server-side only — never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
